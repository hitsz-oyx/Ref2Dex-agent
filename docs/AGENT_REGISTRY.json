  "owner": "root",
  "purpose": "记录每个 Ref2Dex 协作 agent 独立的 Codex 对话身份、CODEX_HOME 与工作树；动态运行状态不在此文件维护。",
  "codex_home_env_var": "CODEX_HOME",
  "codex_home_policy": "每条 agent 记录独立指定 codex_home；允许多个 agent 当前使用同一路径，但不存在注册表级默认或继承。迁移时同步更新该 agent 的会话和数据库定位。",
  "identity_rules": {
    "identity_key": [
      "codex_home",
      "conversation_id"
    ],
    "conversation_id_kind": "codex_thread_id",
    "identity_keys_must_be_unique": true,
    "role_changes_require_contract_update": true,
    "dynamic_status_source": [
      "<codex_home>/sessions/**/*.jsonl",
      "<codex_home>/state_5.sqlite",
      "<codex_home>/goals_1.sqlite",
      "<codex_home>/queue_1.sqlite",
      "Git branch/commit/status",
      "experiment card 和 run manifest"
    ],
    "codex_home_is_per_agent": true,
    "shared_codex_home_allowed": true
  },
  "pool": {
    "mode": "fixed",
    "dynamic_creation": "user_approval_only",
    "max_agents": 5,
    "nested_delegation": "forbidden",
    "dispatch_owner": "root",
    "roles": [
      {
        "agent_key": "root",
        "role": "supervisor",
        "branch": "main",
