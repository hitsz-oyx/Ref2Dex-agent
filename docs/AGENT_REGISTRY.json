        "runtime_binding": null
      },
      {
        "agent_key": "agent_infra",
        "role": "engineering",
        "branch": "agent/infra",
        "runtime_binding": null
      }
    ],
    "branch_policy": {
      "worker_branches": [
        "agent/cm",
        "agent/rl",
        "agent/eval",
        "agent/infra"
      ],
      "task_identity": "experiment_or_task_id_not_branch_name",
      "sync_before_task": "git merge --ff-only main",
      "merge_owner": "root",
      "historical_branches": "retain until separately audited; do not delete as workflow migration"
    }
  },
  "supervision": {
    "mode": "fixed_pool_event_watchdog",
    "fixed_external_wake_message": "RETIRED",
    "retired_scheduler": "/home2/wyy/oyx_ws/ai_ws/Ref2Dex-agent/scripts/codex_research_supervisor.py",
    "polling_owner": "worker_event_poller",
    "decision_and_dispatch_owner": "root",
    "polling_intervals_seconds": {
      "waiting_or_blocked": 300,
      "active_cpu": 300,
      "active_gpu": 120,
      "terminal_audit": 0
    },
    "dispatch_rule": "root 在 MISSION/CAMPAIGN 与当前授权内主动选择可判别的 Blocker、Decision 或直接必要的工程/治理任务，并向精确注册 thread 派发明确 GOAL_DISPATCH；不要求先出现 blocker，不发送固定心跳或模糊 continue。",
    "completion_rule": "worker_event_poller 只发送状态/完成事件；root 审计后重新选择和派发任务。",
    "root_goal_lifecycle": {
      "anchor": "persistent_supervision",
      "default_status": "active",
      "child_goal_terminal_does_not_end_root": true,
      "idle_or_milestone_does_not_end_root": true,
      "status_change_authority": [
        "explicit_user_pause_stop_or_switch",
        "explicit_platform_usage_budget_or_lifecycle_limit"
      ],
      "blocked_status_rule": "platform_three_consecutive_repeated_blockers_only",
      "after_child_completion": "return_to_root_task_selection_loop"
    },
    "watchdog_owner": "root_watchdog",
    "poller_script": "scripts/worker_event_poller.py",
    "watchdog_script": "scripts/root_watchdog.py",
    "lease_path": ".runtime/SUPERVISOR_LEASE.json",
    "nested_delegation": "forbidden",
    "watchdog_rule": "root_watchdog 只处理 root liveness、lease-authorized resume 和 budget notification；不选择研究路线。"
  },
