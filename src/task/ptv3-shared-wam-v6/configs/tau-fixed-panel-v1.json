{
  "schema": "ref2dex.tau-fixed-panel.v1",
  "experiment_id": "P-20261023-tau-fixed-panel-metric",
  "task": "ptv3-shared-wam-v6",
  "seed": 170,
  "flow_eval_seed": 172,
  "anchor": "outputs/ptv3-shared-wam-v6/tau-curated-20261023-r2/train-anchor.json",
  "data_manifest": "outputs/ptv3-shared-wam-v6/local-data-20261021-r2/data/recipe/manifest.json",
  "event_recipe": "outputs/ptv3-shared-wam-v6/local-expanded-recipe-20261021-r1/manifest.json",
  "stats": "outputs/ptv3-shared-wam-v6/local-expanded-recipe-20261021-r1/stats.json",
  "preprocessing": {
    "reader": "ptv3_shared_wam_v6.data.V6Windows",
    "split": "train",
    "collate": "ptv3_shared_wam_v5.data.collate",
    "history": 4,
    "horizon": 24,
    "fps": 30,
    "event_condition_dropout": false
